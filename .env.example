# ---- Database (any PostgreSQL: local Docker, Supabase, AWS RDS) ----
# Runtime connection. On Supabase use the pooler URL (port 6543, transaction mode) and set DB_PREPARE=false.
DATABASE_URL=postgres://erp:erp@localhost:5433/erp
# Migrations connection (direct, NOT the pooler). Falls back to DATABASE_URL if empty.
DIRECT_URL=
# disable | require | verify-full   (Supabase: require; RDS: verify-full + DB_SSL_CA)
DB_SSL=disable
# Path to PEM bundle (RDS global bundle) or the PEM contents; only used with verify-full
DB_SSL_CA=
DB_PREPARE=true
DB_POOL_MAX=10

# ---- Security ----
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Comma-separated role keys that MUST enrol TOTP 2FA (e.g. admin,accountant). Empty = not enforced (dev).
MFA_REQUIRED_ROLES=
# Seed password for demo users (dev only!)
SEED_PASSWORD=ChangeMe@123
# Set to true only behind a trusted reverse proxy that sets x-forwarded-for
TRUST_PROXY=false
APP_NAME=Mini ERP
